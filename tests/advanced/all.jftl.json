{
    "main": {
        "$": true,
        "data": [
            [ ],
            [ 2 ],
            [ 3 ],
            [ 2, 4, 6],
            [ 3, 5, 7],
            [ 1, 2, 3],
            [ 3, 4, 5, 6, 7]
        ],
        "foreach": {
            "var": "v",
            "out": {
                "data": "$v",
                "all_even": {
                    "$": true,
                    "foreach": { "var": "d", "in": "$v", "limit": 1, "if": "$= not d % 2 == 0", "out": true  },
                    "out": "$= not bool(_)"
                }
            }
        }
    },
    "config": {
        "default_expr_engine": "py"
    }
}