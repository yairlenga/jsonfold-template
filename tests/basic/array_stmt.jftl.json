{
    "main": {
        "$": {
            "set": { "pets" : [ { "class": "dog", "name": "Pluto" }, { "class": "mouse", "name": "Micky" }, { "class": "mouse", "name": "Minnie" } ]}
        },
        "names": [
            { "$": { "data": "$pets", "foreach": {} }},
            "$.name"
        ],
        "Using $x": [
            { "$": { "foreach": { "var": "x", "in": "$pets" } }},
            "$x.name"
        ],
        "If-False": [
            { "$": { "check": false, "data": "$pets", "foreach": {}}},
            "$.name"
        ],
        "If-Missing": [
            { "$": { "check": false, "data": "$pets", "foreach": {}, "fallback": "MISSING"}},
            "$.name"
        ],
        "ERROR": [
            { "$": { "data": "$pets", "foreach": {}, "fallback": "MISSING", "error": "ERROR"}},
            "$_error"
        ],
        "_": "_"
    }
}