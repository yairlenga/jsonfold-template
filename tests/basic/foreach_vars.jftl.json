{
    "main": {
        "range(3, 10)": {
            "$": true,
            "foreach": { "in": 10, "start": 3 }
        },
        "range(3, 10),_": {
            "$": true,
            "foreach": { "in": 10, "start": 3, "out": "$_" }
        },
        "range(3, 10),_key": {
            "$": true,
            "foreach": { "var": "v", "in": 10, "start": 3, "out": "$_key" }
        },
        "range(3, 10),var": {
            "$": true,
            "foreach": { "var": "v", "in": 10, "start": 3, "out": "$v" }
        },
        "range(3, 10),key": {
            "$": true,
            "foreach": { "key": "k", "in": 10, "start": 3, "out": "$k" }
        },
        "range(3, 10),unset _key": {
            "$": true,
            "foreach": { "key": "k", "in": 10, "start": 3, "out": "$_key" }
        },
        "range(3, 10),unset _": {
            "$": true,
            "data": "UNSET",
            "foreach": { "var": "v", "in": 10, "start": 3, "out": "$_" }
        },
        "": "_"
    }
}
