{
  "main": {
    "customerName": "$.customer.name",
    "greeting": {
      "$": true,
      "case": [
        {
          "when": "$.customer.vip",
          "then": "$.vipMessage"
        }
      ],
      "out": "$.standardMessage"
    },
    "orderTotal": {
      "$": true,
      "if": "$.hasOrder",
      "out": "$.order.amount",
      "default": "$.noOrderMessage"
    },
    "itemNames": {
      "$": true,
      "foreach": {
        "in": "$.items",
        "out": "$.name"
      }
    }
  }
}