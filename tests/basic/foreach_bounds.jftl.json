{
    "main": {
        "$": true,
        "set": {
            "letters": ["aa", "bb", "cc", "dd", "ee", "ff", "gg", "hh", "ii"],
            "starts": [null, 2, -3],
            "stops": [null, 6, -2],
            "limits": [null, 0, 4]
        },
        "foreach": {
            "in": "$starts",
            "var": "s",
            "out": {
                "$": true,
                "foreach": {
                    "in": "$stops",
                    "var": "e",
                    "out": {
                        "$": true,
                        "foreach": {
                            "in": "$limits",
                            "var": "l",
                            "out": {
                                "start": "$s",
                                "stop": "$e",
                                "limit": "$l",
                                "subset": {
                                    "$": true,
                                    "foreach": {
                                        "in": "$letters",
                                        "start": "$s",
                                        "stop": "$e",
                                        "limit": "$l"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
