{
    "main": {
        "$": true,
	"data": "TOP-DATA",
        "set": {
            "n": 1000,
            "m": 10,
            "t": "$py=n*m",
            "v": 1,
	    "flag": { "item": true },
	    "obj": { "kv": "=k", "n": [ "=n1", "=n2", "=n3" ],
            "k": { "kv": "=kk", "n": [ "=kn1", "=kn2", "=kn3" ],
                "k": { "kv": "=kkv", "n": [ "=kkn1", "=kkn2", "=kkn3" ]}
            }
        },
	    "arr": [ "=1", "=2", "=3", "=4", "=5" ]
        },
    	
	"out": {
            "data": "HERE",
	    "$": true,
            "foreach": {
                "in": "$t",
                "if": "$flag.item",
                "out": { "v": "$v", "t": "$_", "z": "z", "data": "$", "top": "$^", "parent": "$<", "here": "$",
		        "var.k": "$obj.kv", "var.kk": "$obj.k.kv", "var.kkk": "$obj.k.k.kv",
		        "var": "$arr[2]", "var.kn": "$obj.n[2]", "var.kkn": "$obj.k.n[2]" ,
                "missing.k": "$missing.missing",
			"missing": "$_missing", "skip": "$_skip", "break": "$_break",
			"break-error": true
	        }
            },
	    "out": [ "T=${t}", "$_[-1]" ]
	}
    }
}
