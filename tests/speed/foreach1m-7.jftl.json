{
    "main": {
        "$": true,
        "set": {
            "n": 1000,
            "m": 100,
            "t": "$py=n*m",
            "v": 1,
	    "flag": { "item": true },
	    "obj": { "foo": { "bar": "baz" }},
	    "arr": { "foo": [ "a", "b", "c", "d", "e" ] }
        },
    	
        "foreach": {
            "in": "$t",
            "if": "$flag.item",
            "out": { "v": "$v", "t": "$_", "z": "z", "obj": "$obj.foo.bar", "arr": "$arr.foo[2]"  }
        },
	    "out": [ "T=${t}", "$_[-1]" ]
    }
}
