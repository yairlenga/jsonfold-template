{
    "main": {
        "$": true,
        "set": {
            "flag": { "item": 1 },
            "n": 1000,
            "m": 1000,
            "t": "$py=n*m",
            "v": 1
        },
        "foreach": { "in": "$t", "if": "$flag.item", "out": { "v": "$v", "t": "$_", "z": "z" } },
        "out": [ "T=${t}", "$_[-1]" ]
    }
}
