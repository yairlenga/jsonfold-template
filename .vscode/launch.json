    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: jf_template",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/scripts/jf_template.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/python",
            "args": [ "-v", "--all-plugins", "data/country10.jftl.json.json" ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/src"
            }
        },
        {
            "name": "Python: CLI test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/scripts/jf_template.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/tests/basic",
            "args": [ "-v", "--all-plugins", "../basic/multiply.jftl.json"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/src"
            }
        },

        {
            "name": "Python: test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/tests/test_nav_node.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/src"
            }
        }
    ]
}