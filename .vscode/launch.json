{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: jf_template",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/scripts/jf_template.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/python",
            "args": [ "-v", "--all-plugins", "-fjsonl", "--target=tmp", "-map=-", "data/copy.jftl.json", "obj1.jsonl"  ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/src"
            }
        },
        {
            "name": "Python: CLI test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/scripts/jf_template.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/tests",
            "args": [ "-v", "--all-plugins", "speed/foreach1m-3.jftl.json"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/src"
            }
        },

        {
            "name": "Python: test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/tests/test_logic_elem.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/src"
            }
        }
    ]
}